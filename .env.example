# Sem esta variável o worker recusa toda chamada, /health incluído (seção 6
# do plano). É o mesmo Bearer que o lado Nuxt chama de CFMV_WORKER_TOKEN.
CFMV_WORKER_TOKEN=

# Opcionais, com o default entre parênteses.
# HOST=0.0.0.0
# PORT=8000
# HEADLESS=true
# LOOKUP_TIMEOUT_MS=20000
# MIN_INTERVAL_SECONDS=3.0
# RESTART_AFTER_FAILURES=5
# RESTART_AFTER_HOURS=6.0
# BLOCK_COOLDOWN_SECONDS=900.0

# So pros scripts manuais (go_no_go.py, foto_lookup.py): default de --uf e
# --inscricao pra testar sem digitar toda vez. O worker nunca le isto. Use
# uma inscricao real sua ou de teste — nao commite um registro de terceiro.
# TEST_UF=
# TEST_INSCRICAO=
